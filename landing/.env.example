# Copy to .env.local for local dev, and set the same variable in Hostinger (hPanel → Node.js → Environment).
# GA4 → Admin → Data streams → Web → Measurement ID (format G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional — defaults to https://universmarbre.com
# NEXT_PUBLIC_SITE_URL=https://universmarbre.com

# Optional — makes public catalogue pages read products, categories, images,
# and indicative prices from the Spring API. Without it, the landing's JSON
# catalogue remains the read-only fallback.
# UNIVMAR_API_URL=http://localhost:8080/api/v1

# Floating AI assistant (server-side only)
MISTRAL_API_KEY=your-mistral-api-key
# Optional — defaults to mistral-small-latest
# MISTRAL_MODEL=mistral-small-latest

# Contact form (SMTP — Hostinger: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@universmarbre.com
SMTP_PASS=your-email-password
# Optional — defaults to SMTP_USER / contact@universmarbre.com
# SMTP_FROM=contact@universmarbre.com
# CONTACT_TO=contact@universmarbre.com

# Private product admin panel (/admin)
ADMIN_PASSWORD=choose-a-strong-password
