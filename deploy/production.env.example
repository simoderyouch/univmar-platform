# Keep this file out of source control after replacing the values. Store every
# secret in the deployment platform's secret manager.
SPRING_PROFILES_ACTIVE=production

POSTGRES_DB=univmar
POSTGRES_USER=univmar
POSTGRES_PASSWORD=replace-with-a-unique-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.internal:5432/univmar?sslmode=require
SPRING_DATASOURCE_USERNAME=univmar
SPRING_DATASOURCE_PASSWORD=replace-with-a-unique-database-password

# Generate with: openssl rand -base64 48
UNIVMAR_JWT_SECRET=replace-with-a-unique-48-byte-random-secret
UNIVMAR_INITIAL_ADMIN_EMAIL=admin@universmarbre.com
UNIVMAR_INITIAL_ADMIN_PASSWORD=replace-with-a-one-time-strong-password
UNIVMAR_PUBLIC_API_URL=https://erp.universmarbre.com/api/v1
UNIVMAR_CORS_ALLOWED_ORIGINS=https://universmarbre.com

# Landing website (the container uses the internal API service for CMS reads).
NEXT_PUBLIC_SITE_URL=https://universmarbre.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
MISTRAL_API_KEY=replace-with-mistral-key-if-assistant-is-enabled
MISTRAL_MODEL=mistral-small-latest
LANDING_PORT=3001

# Keep the bucket private. The API, not this endpoint, serves uploaded images.
UNIVMAR_STORAGE_PROVIDER=s3
UNIVMAR_STORAGE_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
UNIVMAR_STORAGE_S3_REGION=eu-west-1
UNIVMAR_STORAGE_S3_BUCKET=univmar-production-private
UNIVMAR_STORAGE_S3_ACCESS_KEY=replace-with-private-bucket-access-key
UNIVMAR_STORAGE_S3_SECRET_KEY=replace-with-private-bucket-secret

UNIVMAR_WEBSITE_EMAIL_ENABLED=true
UNIVMAR_WEBSITE_EMAIL_TO=sales@universmarbre.com
UNIVMAR_WEBSITE_EMAIL_FROM=erp@universmarbre.com
# Sends quotation PDFs and secure client links through the same SMTP account.
UNIVMAR_QUOTATION_EMAIL_ENABLED=true
UNIVMAR_QUOTATION_EMAIL_FROM=erp@universmarbre.com
UNIVMAR_QUOTATION_PUBLIC_BASE_URL=https://universmarbre.com/fr/quote
SPRING_MAIL_HOST=smtp.your-provider.example
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=erp@universmarbre.com
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
